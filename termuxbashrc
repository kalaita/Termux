KSI1='csname'
KSI2='csname'
export PS1='\[\e[31m\]Termux @\[\e[39m\] \[\e[1;39m\]\w \$\[\e[0m\] '
alias 'e'='clear && exit'
alias 'reload'="source ~/.bashrc"
alias 'c'='clear'
alias 'cs'='clear && gh cs ssh -c "$KSI1"'
alias 'stop'='clear && gh cs stop'
alias 'la'='ls -A'
alias 'co'='clear && gh cs ssh -c "$KSI2"'
